# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# NHTSA vPIC external API
VPIC_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
VPIC_TIMEOUT_MS=15000
VPIC_MAX_RETRIES=3

# DynamoDB
DYNAMODB_PORT=8000
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE_NAME=VehicleMakes
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Ingestion
# INGESTION_MAX_MAKES=0 ingests every make returned by the API
INGESTION_CONCURRENCY=10
INGESTION_MAX_MAKES=200
INGEST_ON_STARTUP=false
